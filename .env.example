# ==========================================
# Nimrobo MCP Server Configuration
# ==========================================

# Nimrobo API Base URL
NIMROBO_API_BASE_URL=https://app.nimroboai.com

# Registered OAuth Public Client ID (from spec: nitrostack_mcp)
NIMROBO_CLIENT_ID=nitrostack_mcp

# OAuth Endpoints
NIMROBO_AUTH_URL=https://app.nimroboai.com/oauth/authorize
NIMROBO_TOKEN_URL=https://app.nimroboai.com/api/oauth/token

# Exact Callback / Redirect URI (Must match byte-for-byte in OAuth request)
NIMROBO_REDIRECT_URI=https://mcp.nitrostack.dev/oauth/callback

# Allowed OAuth Scope (spec allows user:read)
NIMROBO_SCOPE=user:read

# Optional Direct Access Token (Bearer) for headless or CI environments
# NIMROBO_ACCESS_TOKEN=your_30_day_opaque_access_token_here

# Enable Mock Mode for offline testing / sandbox execution (true / false)
NIMROBO_MOCK_MODE=true

# OAuth 2.1 Enforcement (set to true in production to reject unauthenticated requests)
OAUTH_REQUIRED=false
RESOURCE_URI=https://app.nimroboai.com
AUTH_SERVER_URL=https://app.nimroboai.com
